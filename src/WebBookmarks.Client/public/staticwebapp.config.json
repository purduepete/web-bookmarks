{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/assets/*", "/api/*"]
    },
    "routes": [
        {
            "route": "/api/*",
            "allowedRoles": ["anonymous"]
        }
    ],
    "globalHeaders": {
        "Cache-Control": "no-cache"
    },
    "responseOverrides": {
        "200": {
            "headers": {
                "Cache-Control": "no-cache"
            }
        }
    }
}
