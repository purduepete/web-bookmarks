#!/bin/sh
echo "Running pre-commit checks..."

# TypeScript type check (client)
echo "  Checking TypeScript..."
cd src/WebBookmarks.Client
npx tsc -b --noEmit 2>&1
TSC_EXIT=$?
cd ../..

if [ $TSC_EXIT -ne 0 ]; then
    echo "❌ TypeScript check failed. Fix errors before committing."
    exit 1
fi

# .NET build check (API)
echo "  Checking .NET build..."
dotnet build src/WebBookmarks.Api/WebBookmarks.Api.csproj --no-restore -c Release -v q 2>&1
DOTNET_EXIT=$?

if [ $DOTNET_EXIT -ne 0 ]; then
    echo "❌ .NET build failed. Fix errors before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed."
